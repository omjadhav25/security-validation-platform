# Copy this to backend/.env on the EC2 instance and fill in real values.
# This file is read by systemd (EnvironmentFile=) - keep it on the server only, never commit it to git.

# From your RDS instance's "Connectivity & security" tab (the endpoint), plus the
# master username/password and db name you set when creating the database.
DATABASE_URL=postgresql://svpadmin:YOUR_DB_PASSWORD@YOUR-RDS-ENDPOINT.rds.amazonaws.com:5432/securitydb

# Generate a real random value, e.g. run: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING

# The sslip.io hostname you'll create from your EC2's Elastic IP, e.g.:
# https://3-91-23-10.sslip.io
BACKEND_URL=https://YOUR-SSLIP-HOSTNAME

# Your Vercel frontend URL
FRONTEND_URL=https://your-app.vercel.app
